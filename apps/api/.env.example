# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/Neostats?schema=public
PORT=4000
# Trusted browser origins for credentialed CORS (comma separated, never `*`).
CORS_ORIGIN=http://localhost:3000
# Required in production (min 32 chars, random). Dev falls back to an ephemeral secret if unset.
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
# Optional: JWT lifetime (default 8h).
JWT_EXPIRES_IN=8h
# Optional: auth cookie name (default neostats_token).
AUTH_COOKIE_NAME=neostats_token
# Optional: development seed overrides (defaults documented in README.md).
#SEED_ADMIN_EMAIL=admin@neostats.dev
#SEED_ADMIN_PASSWORD=change-me-locally
#SEED_MANAGER_EMAIL=manager@neostats.dev
#SEED_MANAGER_PASSWORD=change-me-locally
#SEED_MEMBER_EMAIL=member@neostats.dev
#SEED_MEMBER_PASSWORD=change-me-locally
#SEED_VIEWER_EMAIL=viewer@neostats.dev
#SEED_VIEWER_PASSWORD=change-me-locally
